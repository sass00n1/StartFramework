          </mxGeometry>
        </mxCell>
        <mxCell id="-TDDyAZX5vg_yCtTEK7J-63" parent="1" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;" value="&lt;div&gt;链甲(1971)：&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;一款中世纪兵棋推演游戏，其中包括大规模战斗规则，比武规则，人与人战斗规则。" vertex="1">
          <mxGeometry height="200" width="250" x="748.9999999999999" y="-816" as="geometry" />
